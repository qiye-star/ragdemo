# 复制为 .env 后按需修改。密钥只出现在环境变量里，绝不进代码与提交记录。
POSTGRES_PASSWORD=ragdemo

# 宿主机映射端口。默认 5433，避开开发机上常见的既有 postgres（5432）。
RAGDEMO_DB_PORT=5433

# 管理连接：测试夹具用它建/删临时库
RAGDEMO_ADMIN_DSN=postgresql://postgres:ragdemo@127.0.0.1:5433/postgres
# 业务连接：ragdemo db migrate / seed / check 用它
RAGDEMO_DSN=postgresql://postgres:ragdemo@127.0.0.1:5433/ragdemo

# MCP 网关（windIFinD-mcp，adr 待补）。**没有默认值**：地址属于部署配置，
# 仓库里写死一个明文公网端点会让任何一份 clone 默认把查询发过去。
RAGDEMO_MCP_GATEWAY_URL=

# 网关走明文 HTTP 发往公网时的显式放行开关。默认不放行——查询带着实体代码与
# as_of、响应是实体财务数据，明文过公网违反「数据境内存储」的意图。
# 正确做法是给网关加 TLS；这个开关只是过渡期的逃生口，打开会留 WARNING 日志。
RAGDEMO_MCP_GATEWAY_ALLOW_INSECURE=

# 访问网关本身的凭据（网关加鉴权之后）。生产路径上由出网代理注入为
# Authorization 头，业务代码不读它。
MCP_GATEWAY_TOKEN=

# 原始 PDF 与解析产物的本地对象存储根目录（LocalBlobStore）。相对路径相对
# 当前工作目录解析；不设置时代码默认取 data/blob。data/ 已经在 .gitignore
# 里，这里留空只是为了让这个变量的存在与含义在 .env.example 里可见。
RAGDEMO_BLOB_ROOT=

# TextIn xParse（合合信息，adr/0008）。docs/09-compliance-security.md §4.1：
# 认证头（x-ti-app-id / x-ti-secret-code）由出网代理转发时注入，业务容器的
# 环境变量里不出现任何供应商密钥，TEXTIN_APP_ID / TEXTIN_SECRET_CODE 因此
# 不在这份清单里——它们只属于 infra/docker-compose.yml 的出网代理配置。

# xParse 的访问地址。**没有默认值**：本地开发通常指向 127.0.0.1 上的出网
# 代理（如 http://127.0.0.1:8081），直接写死一个公网地址会让每一份 clone
# 默认把文档发到境外服务，违反 CLAUDE.md §0 数据境内存储。
TEXTIN_BASE_URL=

# 是否允许把用户私有材料送去解析。默认不放行（留空即 false）——
# 打开之前必须先落实数据处理协议与用户告知（docs/adr/0008 后果 1）。
TEXTIN_ALLOW_PRIVATE=

# 每次 Dagster run（或一次 `ragdemo docs ingest`）允许消耗的 xParse 页数
# 预算。留空则代码取默认值 500；解析按页计费，这道闸门挡的是回填场景
# 一夜之间烧穿月度预算。
TEXTIN_MAX_PAGES_PER_RUN=

# C 档（阶段 G：低置信度文档二次解析）的单页单价，人民币。**没有默认值**：
# 这是商务合同定价，不该由代码编造一个数字——没设置时月度预算判断直接
# 报错拒绝，不会假装算出了一个准数（parse/router.py::check_monthly_
# budget 的调用方经 config.py::require_textin_cost_per_page_cny 读取）。
TEXTIN_COST_PER_PAGE_CNY=
